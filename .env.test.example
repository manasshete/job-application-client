# Template for a TEST setup. Copy to .env.local (after backing up the current
# .env.local, which points at the client's production Supabase project) and fill
# in values from YOUR OWN test Supabase project.

NEXT_PUBLIC_SUPABASE_URL=https://<test-ref>.supabase.co
SUPABASE_URL=https://<test-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=test-cron-secret

# Optional. Without RESEND_API_KEY, password-reset links are printed to the
# dev server console instead of emailed.
RESEND_API_KEY=
